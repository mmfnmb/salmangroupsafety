// Maintain360 — Saudi Digital Asset & Maintenance Management Platform
// Independent SaaS product. Not connected to any legacy system.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// PLATFORM / TENANCY
// ─────────────────────────────────────────────────────────────────────────

enum PlanTier {
  STARTER
  BUSINESS
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Plan {
  id             String   @id @default(cuid())
  tier           PlanTier @unique
  nameEn         String
  nameAr         String
  monthlyPriceSar Decimal @db.Decimal(10, 2)
  annualPriceSar  Decimal @db.Decimal(10, 2)
  assetLimit     Int?
  userLimit      Int?
  siteLimit      Int?
  features       Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizations Organization[]
}

enum Industry {
  MANUFACTURING
  WAREHOUSE_LOGISTICS
  STAFF_ACCOMMODATION
  COMMERCIAL_BUILDING
  HEALTHCARE
  EDUCATION
  RETAIL
  HOSPITALITY
  OFFICE
  PROPERTY_PORTFOLIO
  WORKSHOP
  BUSINESS_PARK
  OTHER
}

model Organization {
  id             String              @id @default(cuid())
  name           String
  nameAr         String?
  slug           String              @unique
  industry       Industry            @default(OTHER)
  city           String?
  crNumber       String?
  vatNumber      String?
  logoUrl        String?
  primaryColor   String?             @default("#1d4ed8")
  locale         String              @default("en")
  planId         String?
  plan           Plan?               @relation(fields: [planId], references: [id])
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt    DateTime?
  hasMaintenanceTeam Boolean         @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  users          User[]
  sites          Site[]
  assets         Asset[]
  assetSystems   AssetSystemType[]
  requests       MaintenanceRequest[]
  workOrders     WorkOrder[]
  slaPolicies    SlaPolicy[]
  pmPlans        PMPlan[]
  checklists     Checklist[]
  technicians    Technician[]
  contracts      Contract[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  weeklyReports  WeeklyReport[]
  rfqs           Rfq[]
  vendorBlacklist VendorBlacklistEntry[]
  approvalThresholds ApprovalThreshold[]

  @@index([slug])
}

// ─────────────────────────────────────────────────────────────────────────
// USERS / RBAC
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  // Platform
  SUPER_ADMIN
  OPERATIONS_MANAGER
  PROCUREMENT_MANAGER
  VENDOR_MANAGER
  FINANCE_ADMIN
  PLATFORM_AUDITOR
  // Customer
  ACCOUNT_OWNER
  FACILITY_MANAGER
  MAINTENANCE_MANAGER
  MAINTENANCE_SUPERVISOR
  TECHNICIAN
  PROCUREMENT_USER
  FINANCE_USER
  REQUESTER
  VIEWER
  // Vendor
  VENDOR_OWNER
  VENDOR_ESTIMATOR
  VENDOR_SUPERVISOR
  VENDOR_TECHNICIAN
  VENDOR_FINANCE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  vendorId     String?
  vendor       Vendor?    @relation(fields: [vendorId], references: [id])
  email        String     @unique
  passwordHash String
  name         String
  nameAr       String?
  phone        String?
  role         UserRole
  locale       String     @default("en")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  technicianProfile Technician?
  requestsMade      MaintenanceRequest[] @relation("RequestedBy")
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@index([orgId])
  @@index([vendorId])
}

// ─────────────────────────────────────────────────────────────────────────
// ASSET HIERARCHY
// ─────────────────────────────────────────────────────────────────────────

enum SiteStatus {
  ACTIVE
  INACTIVE
}

model Site {
  id        String     @id @default(cuid())
  orgId     String
  organization Organization @relation(fields: [orgId], references: [id])
  code      String
  name      String
  nameAr    String?
  city      String
  address   String?
  latitude  Float?
  longitude Float?
  status    SiteStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  buildings  Building[]
  assets     Asset[]
  requests   MaintenanceRequest[]
  workOrders WorkOrder[]
  technicians TechnicianSite[]
  rfqs       Rfq[]

  @@unique([orgId, code])
  @@index([orgId])
}

model Building {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name   String
  nameAr String?

  floors Floor[]
  assets Asset[]

  @@index([siteId])
}

model Floor {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String

  rooms  Room[]
  assets Asset[]

  @@index([buildingId])
}

model Room {
  id      String @id @default(cuid())
  floorId String
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name    String

  assets Asset[]

  @@index([floorId])
}

// System category (HVAC, Electrical, Fire Alarm, ...). Platform-seeded + org-extensible.
model AssetSystemType {
  id     String  @id @default(cuid())
  orgId  String?
  organization Organization? @relation(fields: [orgId], references: [id])
  code   String
  nameEn String
  nameAr String

  assets Asset[]

  @@unique([orgId, code])
}

enum AssetStatus {
  OPERATIONAL
  DOWN
  UNDER_MAINTENANCE
  DECOMMISSIONED
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CRITICAL
}

model Asset {
  id           String   @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id])
  buildingId   String?
  building     Building? @relation(fields: [buildingId], references: [id])
  floorId      String?
  floor        Floor?    @relation(fields: [floorId], references: [id])
  roomId       String?
  room         Room?     @relation(fields: [roomId], references: [id])
  systemTypeId String?
  systemType   AssetSystemType? @relation(fields: [systemTypeId], references: [id])

  assetCode String // e.g. DAM01-A-HVAC-SAC-001, immutable once set
  qrToken   String @unique @default(cuid())

  name    String
  nameAr  String?
  type    String?
  manufacturer String?
  brand        String?
  model        String?
  serialNumber String?
  barcode      String?

  status      AssetStatus      @default(OPERATIONAL)
  criticality AssetCriticality @default(MEDIUM)
  condition   AssetCondition   @default(GOOD)

  technicalSpecs Json? // flexible custom fields per asset type

  // Commercial
  supplierName      String?
  purchasePriceSar  Decimal? @db.Decimal(12, 2)
  installationCostSar Decimal? @db.Decimal(12, 2)
  purchaseDate      DateTime?
  installationDate  DateTime?
  commissioningDate DateTime?

  // Warranty
  warrantyStart    DateTime?
  warrantyEnd      DateTime?
  warrantyProvider String?

  // Lifecycle
  usefulLifeYears      Int?
  replacementCostSar   Decimal? @db.Decimal(12, 2)
  estimatedReplacementDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    AssetDocument[]
  requests     MaintenanceRequest[]
  workOrders   WorkOrder[]
  pmPlans      PMPlan[]
  meters       AssetMeter[]
  relocations  AssetRelocation[]
  rfqs         Rfq[]

  @@unique([orgId, assetCode])
  @@index([orgId, siteId])
  @@index([qrToken])
}

enum AssetDocumentType {
  MANUAL
  DATASHEET
  WARRANTY
  TEST_CERTIFICATE
  DRAWING
  PHOTO
  VIDEO
  INSPECTION_REPORT
  OTHER
}

model AssetDocument {
  id        String            @id @default(cuid())
  assetId   String
  asset     Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type      AssetDocumentType
  name      String
  url       String
  uploadedAt DateTime         @default(now())

  @@index([assetId])
}

model AssetRelocation {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromLocation String
  toLocation   String
  movedAt   DateTime @default(now())
  reason    String?

  @@index([assetId])
}

model AssetMeter {
  id       String @id @default(cuid())
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name     String // e.g. Runtime Hours
  unit     String // e.g. hours, cycles

  readings AssetMeterReading[]

  @@index([assetId])
}

model AssetMeterReading {
  id        String     @id @default(cuid())
  meterId   String
  meter     AssetMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  value     Float
  recordedAt DateTime  @default(now())

  @@index([meterId])
}

// ─────────────────────────────────────────────────────────────────────────
// MAINTENANCE REQUESTS
// ─────────────────────────────────────────────────────────────────────────

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
  CRITICAL
}

enum RequestStatus {
  NEW
  TRIAGED
  CONVERTED
  REJECTED
  DUPLICATE
}

enum RequestSource {
  QR_SCAN
  PUBLIC_PORTAL
  INTERNAL_PORTAL
  PHONE
}

model MaintenanceRequest {
  id             String   @id @default(cuid())
  orgId          String
  organization   Organization @relation(fields: [orgId], references: [id])
  referenceNumber String  // REQ-YYYY-XXXXXX, unique per organization
  siteId         String
  site           Site     @relation(fields: [siteId], references: [id])
  assetId        String?
  asset          Asset?   @relation(fields: [assetId], references: [id])

  requesterName  String
  requesterPhone String?
  requesterEmail String?
  requesterUserId String?
  requesterUser  User?    @relation("RequestedBy", fields: [requesterUserId], references: [id])

  category    String?
  description String
  priority    RequestPriority @default(NORMAL)
  status      RequestStatus   @default(NEW)
  source      RequestSource   @default(INTERNAL_PORTAL)

  photoUrls String[] @default([])
  videoUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrder WorkOrder?
  rfq       Rfq?

  @@unique([orgId, referenceNumber])
  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────
// WORK ORDERS
// ─────────────────────────────────────────────────────────────────────────

enum WorkOrderStatus {
  NEW
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ON_SITE
  DIAGNOSIS
  WAITING_APPROVAL
  WAITING_PARTS
  IN_PROGRESS
  TESTING
  COMPLETED
  CUSTOMER_VERIFICATION
  CLOSED
  REOPENED
  CANCELLED
}

enum WorkOrderType {
  CORRECTIVE
  PREVENTIVE
  EMERGENCY
  INSPECTION
  PROJECT
}

model WorkOrder {
  id        String   @id @default(cuid())
  orgId     String
  organization Organization @relation(fields: [orgId], references: [id])
  number    String   // WO-YYYY-XXXXXX, unique per organization

  requestId String?  @unique
  request   MaintenanceRequest? @relation(fields: [requestId], references: [id])

  siteId  String
  site    Site    @relation(fields: [siteId], references: [id])
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  type     WorkOrderType @default(CORRECTIVE)
  category String?
  priority RequestPriority @default(NORMAL)
  description String

  assignedTechnicianId String?
  assignedTechnician   Technician? @relation(fields: [assignedTechnicianId], references: [id])
  assignedVendorId     String?
  assignedVendor       Vendor?     @relation(fields: [assignedVendorId], references: [id])

  slaPolicyId String?
  slaPolicy   SlaPolicy? @relation(fields: [slaPolicyId], references: [id])

  status WorkOrderStatus @default(NEW)

  createdAt    DateTime  @default(now())
  respondedAt  DateTime?
  arrivedAt    DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  approvedAt   DateTime?
  closedAt     DateTime?

  downtimeMinutes Int?

  laborCostSar Decimal? @db.Decimal(10, 2)
  partsCostSar Decimal? @db.Decimal(10, 2)
  totalCostSar Decimal? @db.Decimal(10, 2)

  rootCause        String?
  correctiveAction String?
  recommendation   String?

  customerSignoffAt     DateTime?
  customerSignoffStatus String? // APPROVED / REJECTED / REOPENED
  customerRating         Int?    // 1-5
  safetyIncidentReported Boolean @default(false)

  pmScheduleId String?  @unique
  pmSchedule   PMSchedule? @relation(fields: [pmScheduleId], references: [id])

  updatedAt DateTime @updatedAt

  photos       WorkOrderPhoto[]
  laborLogs    WorkOrderLaborLog[]
  partsUsed    WorkOrderPartUsed[]
  checklistResponses ChecklistResponse[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([assignedTechnicianId])
}

enum PhotoStage {
  BEFORE
  DURING
  AFTER
}

model WorkOrderPhoto {
  id          String     @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  stage       PhotoStage
  url         String
  uploadedAt  DateTime   @default(now())

  @@index([workOrderId])
}

model WorkOrderLaborLog {
  id            String    @id @default(cuid())
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  technicianId  String?
  technician    Technician? @relation(fields: [technicianId], references: [id])
  startTime     DateTime
  endTime       DateTime?
  notes         String?

  @@index([workOrderId])
}

model WorkOrderPartUsed {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partName    String
  quantity    Float     @default(1)
  unitCostSar Decimal?  @db.Decimal(10, 2)

  @@index([workOrderId])
}

// ─────────────────────────────────────────────────────────────────────────
// SLA
// ─────────────────────────────────────────────────────────────────────────

model SlaPolicy {
  id     String @id @default(cuid())
  orgId  String
  organization Organization @relation(fields: [orgId], references: [id])
  name   String
  priority RequestPriority
  responseMinutes   Int
  arrivalMinutes    Int
  resolutionMinutes Int
  isActive Boolean @default(true)

  workOrders WorkOrder[]

  @@unique([orgId, priority])
}

// ─────────────────────────────────────────────────────────────────────────
// PREVENTIVE MAINTENANCE
// ─────────────────────────────────────────────────────────────────────────

enum PMFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  METER_BASED
}

model PMPlan {
  id      String @id @default(cuid())
  orgId   String
  organization Organization @relation(fields: [orgId], references: [id])
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  name      String
  frequency PMFrequency
  intervalValue Int @default(1) // e.g. every N months, or meter units

  checklistId String?
  checklist   Checklist? @relation(fields: [checklistId], references: [id])

  assignedTechnicianId String?
  assignedTechnician   Technician? @relation(fields: [assignedTechnicianId], references: [id])

  estimatedDurationMinutes Int?
  instructions String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules PMSchedule[]

  @@index([orgId, assetId])
}

enum PMScheduleStatus {
  UPCOMING
  DUE
  OVERDUE
  COMPLETED
  SKIPPED
}

model PMSchedule {
  id       String   @id @default(cuid())
  pmPlanId String
  pmPlan   PMPlan   @relation(fields: [pmPlanId], references: [id], onDelete: Cascade)
  dueDate  DateTime
  status   PMScheduleStatus @default(UPCOMING)

  workOrder WorkOrder?

  @@index([pmPlanId, dueDate])
}

// ─────────────────────────────────────────────────────────────────────────
// CHECKLISTS
// ─────────────────────────────────────────────────────────────────────────

model Checklist {
  id     String @id @default(cuid())
  orgId  String
  organization Organization @relation(fields: [orgId], references: [id])
  name   String
  items  Json   // [{ id, label, type, required }]
  createdAt DateTime @default(now())

  pmPlans   PMPlan[]
  responses ChecklistResponse[]

  @@index([orgId])
}

model ChecklistResponse {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id])
  responses   Json      // { itemId: value }
  submittedAt DateTime  @default(now())

  @@index([workOrderId])
}

// ─────────────────────────────────────────────────────────────────────────
// TECHNICIANS
// ─────────────────────────────────────────────────────────────────────────

enum TechnicianStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Technician {
  id     String @id @default(cuid())
  orgId  String
  organization Organization @relation(fields: [orgId], references: [id])
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  employeeId String?
  name       String
  nameAr     String?
  trade      String
  phone      String?
  email      String?
  supervisorId String?
  supervisor   Technician? @relation("Supervision", fields: [supervisorId], references: [id])
  subordinates Technician[] @relation("Supervision")
  status     TechnicianStatus @default(ACTIVE)
  hireDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites             TechnicianSite[]
  certifications    TechnicianCertification[]
  workOrders        WorkOrder[]
  laborLogs         WorkOrderLaborLog[]
  pmPlans           PMPlan[]
  performanceSnapshots TechnicianPerformanceSnapshot[]

  @@index([orgId])
}

model TechnicianSite {
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  siteId       String
  site         Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([technicianId, siteId])
}

model TechnicianCertification {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  name         String
  issuer       String?
  issueDate    DateTime?
  expiryDate   DateTime?
  documentUrl  String?

  @@index([technicianId])
}

model TechnicianPerformanceSnapshot {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime

  responseTimeScore    Float
  slaComplianceScore   Float
  ftfrScore            Float
  repeatFailureScore   Float
  pmCompletionScore    Float
  qualityScore         Float
  documentationScore   Float
  safetyComplianceScore Float
  satisfactionScore    Float
  overallScore         Float

  jobsCompleted Int @default(0)
  computedAt DateTime @default(now())

  @@index([technicianId, periodStart])
}

// ─────────────────────────────────────────────────────────────────────────
// VENDORS (Phase 2 — schema ready now, UI in later iteration)
// ─────────────────────────────────────────────────────────────────────────

enum VendorStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  SUSPENDED
  REJECTED
}

model Vendor {
  id         String       @id @default(cuid())
  name       String
  nameAr     String?
  crNumber   String?
  vatNumber  String?
  address    String?
  phone      String?
  email      String?
  website    String?
  categories String[]     @default([])
  coverageCities String[] @default([])
  emergencyAvailable Boolean @default(false)
  status     VendorStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  workOrders   WorkOrder[]
  documents    VendorDocument[]
  performance  VendorPerformanceSnapshot[]
  rfqInvites   RfqVendor[]
  quotations   Quotation[]
  blacklistedBy VendorBlacklistEntry[]
}

model VendorDocument {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type      String
  name      String
  url       String
  expiryDate DateTime?
  uploadedAt DateTime @default(now())

  @@index([vendorId])
}

model VendorPerformanceSnapshot {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime

  technicalComplianceScore Float
  historicalQualityScore   Float
  priceCompetitivenessScore Float
  responseCapabilityScore  Float
  warrantyScore            Float
  safetyScore              Float
  overallScore             Float

  jobsCompleted Int @default(0)
  computedAt DateTime @default(now())

  @@index([vendorId, periodStart])
}

model VendorBlacklistEntry {
  id       String @id @default(cuid())
  orgId    String
  organization Organization @relation(fields: [orgId], references: [id])
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])
  reason   String?
  createdAt DateTime @default(now())

  @@unique([orgId, vendorId])
}

// ─────────────────────────────────────────────────────────────────────────
// RFQ / PROCUREMENT (Phase 3)
// ─────────────────────────────────────────────────────────────────────────

enum RfqStatus {
  DRAFT
  RELEASED
  QUOTING
  EVALUATING
  AWARDED
  CANCELLED
}

model Rfq {
  id           String   @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  number       String   // RFQ-YYYY-XXXXXX, unique per organization

  siteId  String
  site    Site    @relation(fields: [siteId], references: [id])
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])
  requestId String? @unique
  request   MaintenanceRequest? @relation(fields: [requestId], references: [id])

  title       String
  category    String?
  scopeOfWork String
  quoteDeadline DateTime?
  status      RfqStatus @default(DRAFT)

  createdByUserId String?
  createdAt       DateTime @default(now())

  awardedVendorId     String?
  awardedQuotationId  String? @unique
  awardedQuotation    Quotation? @relation("AwardedQuotation", fields: [awardedQuotationId], references: [id])
  awardedAt           DateTime?
  awardedByUserId     String?
  platformFeePercent  Decimal? @db.Decimal(5, 2)
  platformFeeSar      Decimal? @db.Decimal(12, 2)

  vendors     RfqVendor[]
  quotations  Quotation[] @relation("RfqQuotations")

  @@unique([orgId, number])
  @@index([orgId, status])
}

model RfqVendor {
  id       String @id @default(cuid())
  rfqId    String
  rfq      Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])
  invitedAt DateTime @default(now())

  @@unique([rfqId, vendorId])
}

enum QuotationStatus {
  SUBMITTED
  UNDER_EVALUATION
  SHORTLISTED
  AWARDED
  REJECTED
}

model Quotation {
  id       String @id @default(cuid())
  rfqId    String
  rfq      Rfq    @relation("RfqQuotations", fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  laborCostSar     Decimal? @db.Decimal(12, 2)
  materialsCostSar Decimal? @db.Decimal(12, 2)
  totalCostSar     Decimal? @db.Decimal(12, 2)
  leadTimeDays     Int?
  warrantyMonths   Int?
  paymentTerms     String?
  exclusions       String?
  validUntil       DateTime?
  status           QuotationStatus @default(SUBMITTED)

  technicalScore    Float?
  commercialScore   Float?
  evaluationNotes   String?
  isRecommended     Boolean @default(false)

  submittedAt DateTime @default(now())

  awardedForRfq Rfq? @relation("AwardedQuotation")

  @@unique([rfqId, vendorId])
  @@index([rfqId])
}

// ─────────────────────────────────────────────────────────────────────────
// CONTRACTS
// ─────────────────────────────────────────────────────────────────────────

model Contract {
  id     String @id @default(cuid())
  orgId  String
  organization Organization @relation(fields: [orgId], references: [id])
  vendorId String?
  contractNumber String
  type   String
  scope  String?
  startDate DateTime
  endDate   DateTime
  valueSar  Decimal? @db.Decimal(12, 2)
  status    String @default("ACTIVE")
  createdAt DateTime @default(now())

  @@unique([orgId, contractNumber])
}

// ─────────────────────────────────────────────────────────────────────────
// APPROVALS
// ─────────────────────────────────────────────────────────────────────────

model ApprovalThreshold {
  id       String @id @default(cuid())
  orgId    String
  organization Organization @relation(fields: [orgId], references: [id])
  minAmountSar Decimal @db.Decimal(12, 2)
  maxAmountSar Decimal? @db.Decimal(12, 2)
  requiredRole UserRole
  scope        String // WORK_ORDER, QUOTATION, AWARD, INVOICE, REPLACEMENT

  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS / AUDIT / REPORTING
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id      String   @id @default(cuid())
  orgId   String
  organization Organization @relation(fields: [orgId], references: [id])
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  type    String
  title   String
  body    String
  isRead  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  organization Organization? @relation(fields: [orgId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  previousValue Json?
  newValue      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([orgId, entityType, entityId])
}

model WeeklyReport {
  id        String   @id @default(cuid())
  orgId     String
  organization Organization @relation(fields: [orgId], references: [id])
  weekStart DateTime
  weekEnd   DateTime
  data      Json
  generatedAt DateTime @default(now())

  @@unique([orgId, weekStart])
}

// ─────────────────────────────────────────────────────────────────────────
// LEADS (public sales / vendor sign-up)
// ─────────────────────────────────────────────────────────────────────────

model Lead {
  id         String   @id @default(cuid())
  type       String   // CUSTOMER / VENDOR
  name       String
  company    String?
  phone      String
  email      String?
  city       String?
  industry   String?
  siteCount  Int?
  estimatedAssets Int?
  teamSize   Int?
  mainProblem String?
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
}
