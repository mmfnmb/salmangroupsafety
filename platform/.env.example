DATABASE_URL="postgresql://user:password@localhost:5432/maintain360?schema=public"
AUTH_SECRET="generate-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Maintain360"
CRON_SECRET="generate-a-strong-random-secret"

# Optional — activates the AI Assistant (request triage, scope-of-work
# drafting, quotation recommendation narratives). The platform runs fully
# without it; those screens just show "pending activation" until it's set.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
